Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebGroup.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Register_Object oSelectPosicion

// ZOOM de JugadorPosicion: una posicion asignada a un jugador (tabla intermedia N:M).
// Se abre desde la lista de posiciones de la Zoom del jugador.
// Al crear una nueva, abre directamente la Select de posiciones para elegirla.
Object oZoomJugadorPosicion is a cWebView
    Set psCaption to "Posicion del jugador"
    Set pbShowCaption to False
    Set peWebViewStyle to wvsDrillDown
    Set peViewType to vtZoom
    Set Verify_Save_msg to 0
    Set psStateViewName to "JugadorPosicion"

    Set piMaxWidth to 1024
    Set piColumnCount to 12

    // Estructura de DDO: jugadorposicion tiene dos padres, jugador y posicion
    Object oligaDD is a cligaDataDictionary
    End_Object

    Object oequipoDD is a cequipoDataDictionary
        Set DDO_Server to oligaDD
    End_Object

    Object ojugadorDD is a cjugadorDataDictionary
        Set DDO_Server to oequipoDD
    End_Object

    Object oposicionDD is a cposicionDataDictionary
    End_Object

    Object ojugadorposicionDD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugadorDD
        Set DDO_Server to oposicionDD
        Set Constrain_File to jugador.File_Number
    End_Object

    Set Main_DD to ojugadorposicionDD
    Set Server  to ojugadorposicionDD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 6

        // El jugador es fijo (viene de la vista anterior): solo informativo
        Object oJugadorGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Jugador"
            WebSetResponsive piColumnCount rmMobile to 1

            Object ojugadorNombre is a cWebForm
                Entry_Item jugador.Nombre
                Set piColumnSpan to 4
                Set psLabel to "Nombre"
                Set peLabelPosition to lpTop
                Set pbEnabled to False
            End_Object

            Object ojugadorApellido is a cWebForm
                Entry_Item jugador.Apellido
                Set piColumnSpan to 4
                Set psLabel to "Apellido"
                Set peLabelPosition to lpTop
                Set pbEnabled to False
            End_Object

            Object oequipoNombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 4
                Set psLabel to "Equipo"
                Set peLabelPosition to lpTop
                Set pbEnabled to False
            End_Object
        End_Object

        // La posicion se elige con el boton de busqueda
        Object oPosicionGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Posicion"
            WebSetResponsive piColumnCount rmMobile to 1

            Object oposicionID is a cWebForm
                Entry_Item posicion.ID
                Set piColumnSpan to 3
                Set psLabel to "ID posicion"
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectPosicion

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oposicionNombre is a cWebForm
                Entry_Item posicion.Nombre
                Set piColumnSpan to 9
                Set psLabel to "Nombre"
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectPosicion

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup
        Set psGroupName to "MainActions"

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to C_$Save
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCaption to C_$CategoryEdit
            Set psCSSClass to "WebEditMenuItem"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCaption to "Quitar posicion"
            Set psCSSClass to "WebDeleteMenuItem"

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCaption to C_$ToolTipClear
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object
    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord

        Get GetNavigateData to NavigateData
        Get HasRecord of ojugadorposicionDD to bHasRecord

        WebSet pbRender of oEditBtn          to False
        WebSet pbRender of oSaveBtn          to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn        to False

        // "Quitar posicion" siempre disponible si la asignacion existe (no hace falta pulsar Editar)
        WebSet pbRender of oDeleteBtn to bHasRecord

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn          to True
            WebSet pbRender of oCancelChangesBtn to True
        End
    End_Procedure

    // Objeto auxiliar para abrir la Select de posiciones automaticamente al crear una nueva
    // (mismo truco que oNavigateToInventoryFromNew del ejemplo oficial ZoomOrderDetail).
    Object oNavegarAPosicionAlCrear is a cWebObject
        WebRegisterPath ntNavigateForward oSelectPosicion Self

        Procedure DoNavigate
            Send NavigatePath
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Get NamedValueAdd NavigateData.NamedValues "Cabecera" "Elige la posicion que quieres asignar al jugador" to NavigateData.NamedValues
        End_Procedure
    End_Object

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        If (HasRecord(ojugadorposicionDD)) Begin
            Send SetBreadcrumbCaption (Trim(posicion.Nombre))
        End
        Else Begin
            Send SetBreadcrumbCaption "Nueva posicion"
        End

        Send SetActionButtons

        // Si es nueva, saltamos directamente a elegir la posicion
        If (NavigateData.bNewRecord) Begin
            Send DoNavigate of oNavegarAPosicionAlCrear
        End
    End_Procedure

End_Object
