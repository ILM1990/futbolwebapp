Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebGroup.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebButton.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebColumnButton.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Register_Object oSelectEquipo
Register_Object oZoomJugadorPosicion

// ZOOM de Jugador. El equipo se elige con el boton de busqueda (lookup a oSelectEquipo).
Object oZoomJugador is a cWebView
    Set psCaption to "Jugador"
    Set pbShowCaption to False
    Set peWebViewStyle to wvsDrillDown
    Set peViewType to vtZoom
    Set Verify_Save_msg to 0
    Set psStateViewName to "Jugador"

    Set piMaxWidth to 1024
    Set piColumnCount to 12

    // Estructura de DDO: jugador -> equipo -> liga
    Object oligaDD is a cligaDataDictionary
    End_Object

    Object oequipoDD is a cequipoDataDictionary
        Set DDO_Server to oligaDD
    End_Object

    Object ojugadorDD is a cjugadorDataDictionary
        Set DDO_Server to oequipoDD
    End_Object

    // Relacion N:M: posiciones del jugador (solo las de ESTE jugador gracias a Constrain_File)
    Object oposicionDD is a cposicionDataDictionary
    End_Object

    Object ojugadorposicionDD is a cjugadorposicionDataDictionary
        Set DDO_Server to ojugadorDD
        Set DDO_Server to oposicionDD
        Set Constrain_File to jugador.File_Number
    End_Object

    Set Main_DD to ojugadorDD
    Set Server  to ojugadorDD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 6

        Object oDatosGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Datos del jugador"
            WebSetResponsive piColumnCount rmMobile to 1

            Object ojugadorID is a cWebForm
                Entry_Item jugador.ID
                Set piColumnSpan to 3
                Set psLabel to "ID"
                Set peLabelPosition to lpTop
            End_Object

            Object ojugadorNombre is a cWebForm
                Entry_Item jugador.Nombre
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set psLabel to "Nombre"
                Set peLabelPosition to lpTop
            End_Object

            Object ojugadorApellido is a cWebForm
                Entry_Item jugador.Apellido
                Set piColumnSpan to 6
                Set psLabel to "Apellido"
                Set peLabelPosition to lpTop
            End_Object

            Object ojugadorNacionalidad is a cWebForm
                Entry_Item jugador.Nacionalidad
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set psLabel to "Nacionalidad"
                Set peLabelPosition to lpTop
            End_Object
        End_Object

        Object oEquipoGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Equipo"
            WebSetResponsive piColumnCount rmMobile to 1

            Object oequipoID is a cWebForm
                Entry_Item equipo.ID
                Set piColumnSpan to 3
                Set psLabel to "ID equipo"
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectEquipo

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oequipoNombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 5
                Set psLabel to "Nombre"
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectEquipo

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oligaNombre is a cWebForm
                Entry_Item liga.Nombre
                Set piColumnSpan to 4
                Set psLabel to "Liga"
                Set peLabelPosition to lpTop
                Set pbEnabled to False   // solo informativo
            End_Object
        End_Object

        // Posiciones del jugador (tabla jugadorposicion)
        Object oPosicionesGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Posiciones"
            WebSetResponsive piColumnCount rmMobile to 1

            Object oNuevaPosicionBtn is a cWebButton
                Set piColumnSpan to 3
                Set psCaption to "Anadir posicion"
                Set Server to ojugadorposicionDD

                WebRegisterPath ntNavigateForward oZoomJugadorPosicion Self "NuevaPosicionJugador"

                Procedure OnClick
                    Send NavigatePath
                End_Procedure

                Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                    Move True to NavigateData.bSaveBeforeNavigate   // guarda el jugador antes (si es nuevo)
                    Move True to NavigateData.bNewRecord
                End_Procedure

                // Solo se puede anadir cuando el jugador esta en modo edicion
                Procedure Refresh Integer eMode
                    Boolean bReadOnly bSynching
                    Get AppSynching to bSynching
                    If (not(bSynching)) Begin
                        Get IsViewReadOnly to bReadOnly
                        WebSet pbEnabled to (not(bReadOnly))
                    End
                End_Procedure
            End_Object

            Object oPosicionesList is a cWebList
                Set Server to ojugadorposicionDD
                Set piColumnSpan to 12
                Set piMinHeight to 120
                Set pbServerOnRowClick to True
                Set pbScroll to False
                Set psPlaceHolder to "Este jugador no tiene posiciones"

                Object oposicionNombre is a cWebColumn
                    Entry_Item posicion.Nombre
                    Set psCaption to "Posicion"
                End_Object

                // Boton papelera en cada fila: quita esa posicion al jugador
                Object oQuitarBtn is a cWebColumnButton
                    Set psCaption to "Quitar"
                    Set piWidth to 50
                    Set pbFixedWidth to True
                    Set pbResizable to False
                    Set psBtnCssClass to "WebButtonIcon WebIcon_Delete"
                    Set peAlign to alignRight

                    Procedure OnClick String sButton String sRowId
                        Send Request_Delete of ojugadorposicionDD
                    End_Procedure
                End_Object

                WebRegisterPath ntNavigateForward oZoomJugadorPosicion

                Procedure OnRowClick String sRowID
                    Send NavigatePath
                End_Procedure

                Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                    Get IsViewReadOnly to NavigateData.bReadOnly
                    Move True to NavigateData.bSaveBeforeNavigate
                End_Procedure
            End_Object
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup
        Set psGroupName to "MainActions"

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to C_$Save
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCaption to C_$CategoryEdit
            Set psCSSClass to "WebEditMenuItem"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCaption to C_$Delete
            Set psCSSClass to "WebDeleteMenuItem"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCaption to C_$ToolTipClear
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object
    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord

        Get GetNavigateData to NavigateData
        Get HasRecord of ojugadorDD to bHasRecord

        WebSet pbRender of oEditBtn          to False
        WebSet pbRender of oSaveBtn          to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn        to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn          to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn        to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        If (HasRecord(ojugadorDD)) Begin
            Send SetBreadcrumbCaption (Trim(jugador.Nombre) * Trim(jugador.Apellido))
        End
        Else Begin
            Send SetBreadcrumbCaption "Nuevo jugador"
        End

        Send SetActionButtons
    End_Procedure

End_Object
