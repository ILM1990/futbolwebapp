Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebGroup.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Register_Object oSelectLiga
Register_Object oSelectEntrenador
Register_Object oSelectJugador

// ZOOM de Equipo: ficha de un equipo.
// La liga se elige con el boton de busqueda, que abre la Select de ligas como lookup.
Object oZoomEquipo is a cWebView
    Set psCaption to "Equipo"
    Set pbShowCaption to False
    Set peWebViewStyle to wvsDrillDown
    Set peViewType to vtZoom
    Set Verify_Save_msg to 0
    Set psStateViewName to "Equipo"

    Set piMaxWidth to 1024
    Set piColumnCount to 12

    // Estructura de DDO: equipo y su padre liga
    Object oligaDD is a cligaDataDictionary
    End_Object

    Object oequipoDD is a cequipoDataDictionary
        Set DDO_Server to oligaDD
    End_Object

    Set Main_DD to oequipoDD
    Set Server  to oequipoDD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 6

        Object oDatosGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Datos del equipo"
            WebSetResponsive piColumnCount rmMobile to 1

            Object oequipoID is a cWebForm
                Entry_Item equipo.ID
                Set piColumnSpan to 3
                Set psLabel to "ID"
                Set peLabelPosition to lpTop
            End_Object

            Object oequipoNombre is a cWebForm
                Entry_Item equipo.Nombre
                Set piColumnSpan to 12
                Set psLabel to "Nombre"
                Set peLabelPosition to lpTop
            End_Object
        End_Object

        Object oLigaGroup is a cWebGroup
            Set piColumnCount to 12
            Set piColumnSpan to 12
            Set psCaption to "Liga"
            WebSetResponsive piColumnCount rmMobile to 1

            // Campo de la liga (tabla padre) con boton de busqueda
            Object oligaID is a cWebForm
                Entry_Item liga.ID
                Set piColumnSpan to 3
                Set psLabel to "ID liga"
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectLiga

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oligaNombre is a cWebForm
                Entry_Item liga.Nombre
                Set piColumnSpan to 6
                Set psLabel to "Nombre"
                Set peLabelPosition to lpTop
                Set pbPromptButton to True

                WebRegisterPath ntNavigateForward oSelectLiga

                Procedure OnPrompt
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oligaPais is a cWebForm
                Entry_Item liga.Pais
                Set piColumnSpan to 3
                Set psLabel to "Pais"
                Set peLabelPosition to lpTop
                Set pbEnabled to False   // solo informativo
            End_Object
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup
        Set psGroupName to "MainActions"

        Object oSaveBtn is a cWebMenuItem
            Set psCaption to C_$Save
            Set psCSSClass to "WebSaveMenuItem"

            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object

        Object oEditBtn is a cWebMenuItem
            Set psCaption to C_$CategoryEdit
            Set psCSSClass to "WebEditMenuItem"

            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure
        End_Object

        Object oDeleteBtn is a cWebMenuItem
            Set psCaption to C_$Delete
            Set psCSSClass to "WebDeleteMenuItem"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure
        End_Object

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCaption to C_$ToolTipClear
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send RefreshRecord
            End_Procedure
        End_Object

        // Drilldown: jugadores y entrenador de este equipo (nfFromParent)
        Object oVerJugadoresBtn is a cWebMenuItem
            Set psCaption to "Ver jugadores"
            Set psCSSClass to "WebPromptMenuItem"

            WebRegisterPath ntNavigateForward oSelectJugador

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object

        Object oVerEntrenadorBtn is a cWebMenuItem
            Set psCaption to "Ver entrenador"
            Set peActionDisplay to adMenu

            WebRegisterPath ntNavigateForward oSelectEntrenador

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object
    End_Object

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord

        Get GetNavigateData to NavigateData
        Get HasRecord of oequipoDD to bHasRecord

        WebSet pbRender of oEditBtn          to False
        WebSet pbRender of oSaveBtn          to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn        to False

        // Los drilldown solo tienen sentido si el equipo ya existe
        WebSet pbRender of oVerJugadoresBtn  to bHasRecord
        WebSet pbRender of oVerEntrenadorBtn to bHasRecord

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn          to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn        to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        Send NavigateClose Self
    End_Procedure

    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        If (HasRecord(oequipoDD)) Begin
            Send SetBreadcrumbCaption (Trim(equipo.Nombre))
        End
        Else Begin
            Send SetBreadcrumbCaption "Nuevo equipo"
        End

        Send SetActionButtons
    End_Procedure

End_Object
